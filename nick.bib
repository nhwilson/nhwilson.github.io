@article{hahlAuthenticAppealLying2018,
  title = {The {{Authentic Appeal}} of the {{Lying Demagogue}}: {{Proclaiming}} the {{Deeper Truth}} about {{Political Illegitimacy}}},
  shorttitle = {The {{Authentic Appeal}} of the {{Lying Demagogue}}},
  author = {Hahl, Oliver and Kim, Minjae and Zuckerman Sivan, Ezra W.},
  date = {2018-02},
  journaltitle = {American Sociological Review},
