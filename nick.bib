@article{barlosiusConceptsOriginalityNatural2019,
  title = {Concepts of {{Originality}} in the {{Natural Science}}, {{Medical}}, and {{Engineering Disciplines}}: {{An Analysis}} of {{Research Proposals}}},
  shorttitle = {Concepts of {{Originality}} in the {{Natural Science}}, {{Medical}}, and {{Engineering Disciplines}}},
  author = {Barlösius, Eva},
  date = {2019-11-01},
  journaltitle = {Science, Technology, \& Human Values},
