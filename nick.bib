@article{hackingLanguageTruthReason2012,
  title = {‘{{Language}}, {{Truth}} and {{Reason}}’ 30 ~ Years Later},
  author = {Hacking, Ian},
  date = {2012-12-01},
  journaltitle = {Studies in History and Philosophy of Science Part A},
  shortjournal = {Studies in History and Philosophy of Science Part A},
  series = {Part {{Special Issue}}: {{Styles}} of {{Thinking}}},
  volume = {43},
  number = {4},
  pages = {599--609},
  issn = {0039-3681},
  doi = {10.1016/j.shpsa.2012.07.002},
  url = {https://www.sciencedirect.com/science/article/pii/S0039368112000441},
  urldate = {2024-05-10},
  abstract = {This paper traces the origins of the styles project, originally presented as ‘styles of scientific reasoning’. ‘Styles of scientific thinking \& doing’ is a better label; the styles can also be called genres, or, ways of finding out. A. C. Crombie’s template of six fundamentally distinct ones was turned into a philosophical tool, but with a tinge of Paul Feyerabend’s anarchism. Ways of finding out are not defined by necessary and sufficient conditions, but can be recognized as distinct within a sweeping, anthropological, vision of the European sciences. The approach is unabashedly whiggish. The emergence of these styles is part of what Reviel Netz calls cognitive history, and is to be understood in an ecological way. How did a species like ours, on an Earth like this, develop a few quite general strategies for finding out about, and altering, its world? At a more analytical level, the project invokes Bernard Williams’ notion of truthfulness to explicate the idea that these styles are ‘self-authenticating’ and without foundations. The paper concludes with open questions. What role (for example) have these few fundamentally distinct genres of inquiry played in the formation of the anomalous Western idea of Nature apart from Man?},
  keywords = {A. C. Crombie,Bernard Williams,Ecological history,Reviel Netz,Scientific reason,Styles project},
  file = {/run/media/nick/data/Zotero/storage/2YN2QPFK/Hacking - 2012 - ‘Language, Truth and Reason’ 30years later.pdf;/run/media/nick/data/Zotero/storage/ZFXKHNEM/Hacking_2012_‘Language, Truth and Reason’ 30 years later.pdf;/run/media/nick/data/Zotero/storage/9ZJZ4HPT/S0039368112000441.html}
}

@book{hackingRepresentingInterveningIntroductory1983,
  title = {Representing and {{Intervening}}: {{Introductory Topics}} in the {{Philosophy}} of {{Natural Science}}},
  shorttitle = {Representing and {{Intervening}}},
  author = {Hacking, Ian},
  date = {1983-11-25},
  publisher = {Cambridge University Press},
  location = {Cambridge Cambridgeshire ; New York},
  abstract = {This 1983 book is a lively and clearly written introduction to the philosophy of natural science, organized around the central theme of scientific realism. It has two parts. 'Representing' deals with the different philosophical accounts of scientific objectivity and the reality of scientific entities. The views of Kuhn, Feyerabend, Lakatos, Putnam, van Fraassen, and others, are all considered. 'Intervening' presents the first sustained treatment of experimental science for many years and uses it to give a new direction to debates about realism. Hacking illustrates how experimentation often has a life independent of theory. He argues that although the philosophical problems of scientific realism can not be resolved when put in terms of theory alone, a sound philosophy of experiment provides compelling grounds for a realistic attitude. A great many scientific examples are described in both parts of the book, which also includes lucid expositions of recent high energy physics and a remarkable chapter on the microscope in cell biology.},
  isbn = {978-0-521-28246-8},
  langid = {english},
  pagetotal = {304}
}

