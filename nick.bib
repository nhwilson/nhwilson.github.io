@article{cromartieHARRINGTONIANVIRTUEHARRINGTON1998,
  title = {{{HARRINGTONIAN VIRTUE}}: {{HARRINGTON}}, {{MACHIAVELLI}}, {{AND THE METHOD OF THE}} {{{\mkbibemph{MOMENT}}}}},
  shorttitle = {{{HARRINGTONIAN VIRTUE}}},
  author = {Cromartie, Alan},
  date = {1998-12},
  journaltitle = {The Historical Journal},
  shortjournal = {Hist. J.},
  volume = {41},
  number = {4},
  pages = {987--1009},
  issn = {0018-246X, 1469-5103},
  doi = {10.1017/S0018246X98008115},
  url = {https://www.cambridge.org/core/product/identifier/S0018246X98008115/type/journal_article},
  urldate = {2024-09-15},
  abstract = {This article presents a reinterpretation of James Harrington's  writings. It takes issue  with J. G. A. Pocock's reading, which treats him as importing into  England a Machiavellian  ‘language of political thought’. This reading is the basis  of Pocock's stress on the republicanism of  eighteenth-century opposition values. Harrington's writings were in  fact a most implausible channel  for such ideas. His outlook owed much to Stoicism. Unlike the Florentine,  he admired the  contemplative life; was sympathetic to commerce; and was relaxed about  the threat of ‘corruption’ (a  concept that he did not understand). These views can be associated with  his apparent aims: the  preservation of a national church with a salaried but politically impotent  clergy; and the restoration  of the royalist gentry to a leading role in English politics. Pocock's  hypothesis is shown to be  conditioned by his method; its weaknesses reflect some difficulties inherent  in the notion of ‘languages  of thought’.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/E3SMSXGN/Cromartie - 1998 - HARRINGTONIAN VIRTUE HARRINGTON, MACHIAVELLI, AND THE METHOD OF THE MOMENT.pdf}
}

