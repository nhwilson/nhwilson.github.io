@article{jerolmackTalkCheapEthnography2014,
  title = {Talk {{Is Cheap}}: {{Ethnography}} and the {{Attitudinal Fallacy}}},
  shorttitle = {Talk {{Is Cheap}}},
  author = {Jerolmack, Colin and Khan, Shamus},
  date = {2014-05-01},
  journaltitle = {Sociological Methods \& Research},
  shortjournal = {Sociological Methods \& Research},
  volume = {43},
