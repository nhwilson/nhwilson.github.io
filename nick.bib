  urldate = {2024-09-15},
  abstract = {Social network research is widely considered atheoretical. In contrast, in this article I argue that network analysis often mixes two distinct theoretical frameworks, creating a logically inconsistent foundation. Relationalism rejects essentialism and a priori categories and insists upon the intersubjectivity of experience and meaning as well as the importance of the content of interactions and their historical setting. Formalism is based on a structuralist interpretation of the theoretical works of Georg Simmel. Simmel laid out a neo-Kantian program of identifying a priori categories of relational types and patterns that operate independently of cultural content or historical setting. Formalism and relationalism are internally consistent theoretical perspectives, but there are tensions between them. To pave the way for stronger middle-range theoretical development, I disaggregate the two approaches and highlight the contradictions that must be addressed or resolved for the construction of any general and inclusive theory.},
  langid = {english},
  keywords = {formalism,Georg Simmel,pragmatism,Relationalism,social networks,structuralism,theory},
  file = {/run/media/nick/data/Zotero/storage/7KXJE759/Erikson - 2013 - Formalist and Relationalist Theory in Social Network Analysis.pdf;/run/media/nick/data/Zotero/storage/X6LXJ5WB/Erikson_2013_Formalist and Relationalist Theory in Social Network Analysis.pdf;/run/media/nick/data/Zotero/storage/3BEHDD7S/219.html}
}

@article{eriksonMalfeasanceFoundationsGlobal2006,
  title = {Malfeasance and the {{Foundations}} for {{Global Trade}}},
  author = {Erikson, Emily and Bearman, Peter},
  date = {2006},
  journaltitle = {The American Journal of Sociology},
  volume = {112},
  number = {1},
  eprint = {10.1086/502694},
  eprinttype = {jstor},
  pages = {195--230},
  url = {http://www.jstor.org/stable/10.1086/502694?&Search=yes&searchText=bearman&searchText=erikson&list=hide&searchUri=%2Faction%2FdoBasicSearch%3FQuery%3Derikson%2Bbearman%26acc%3Don%26wc%3Don&prevSearch=&item=1&ttl=81&returnArticleService=showFullText},
  abstract = {Drawing on a remarkable data set compiled from ships’ logs, journals, factory correspondence, ledgers, and reports that provide unusually precise information on each of the 4,572 voyages taken by English traders of the East India Company (hereafter EIC), we describe the EIC trade network over time, from 1601 to 1833. From structural images of voyages organized by shipping seasons, the authors map (over time and space) the emergence of dense, fully integrated, global trade networks to reveal globalization long before what is now called “globalization.” The authors show that the integration of the world trade system under the aegis of the EIC was the unintended by‐product of systematic individual malfeasance (private trading) on the part of ship captains seeking profit from internal Eastern trade.}
}

