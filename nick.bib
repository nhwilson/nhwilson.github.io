@article{stuartbrundageSocialSourcesGeopolitical2018,
  title = {The {{Social Sources}} of {{Geopolitical Power}}: {{French}} and {{British Diplomacy}} and the {{Politics}} of {{Interstate Recognition}}, 1689 to 1789},
