  doi = {10.1177/000312249906400402},
  url = {https://doi.org/10.1177/000312249906400402},
  urldate = {2024-09-09},
  abstract = {I investigate how social embeddedness affects an organization's acquisition and cost of financial capital in middle-market banking—a lucrative but understudied financial sector. Using existing theory and original fieldwork, I develop a framework to explain how embeddedness can influence which firms get capital and at what cost. I then statistically examine my claims using national data on small-business lending. At the level of dyadic ties, I find that firms that embed their commercial transactions with their lender in social attachments receive lower interest rates on loans. At the network level, firms are more likely to get loans and to receive lower interest rates on loans if their network of bank ties has a mix of embedded ties and arm's-length ties. These network effects arise because embedded ties motivate network partners to share private resources, while arm's-length ties facilitate access to public information on market prices and loan opportunities so that the benefits of different types of ties are optimized within one network. I conclude with a discussion of how the value produced by a network is at a premium when it creates a bridge that links the public information of markets with the private resources of relationships.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/RBVB54TF/Uzzi - 1999 - Embeddedness in the Making of Financial Capital How Social Relations and Networks Benefit Firms See.pdf}
}

@unpublished{vahabliCollaborationCompetitionModalities2026,
  title = {Collaboration and {{Competition}}: {{Modalities}} of {{Field Dependence}}, {{Diasporic Protests}}, and {{Immigrant Governance}}},
  author = {Vahabli, Danial},
  date = {2026},
  abstract = {What does it mean for collective actors to be interdependent? Prior literature often reduces dependence on collaboration based on resource sharing or overlapping networks, but competitive actors are in fact highly interdependent through attempting at other’s defeat. By focusing on strategic action fields, I introduce the notion of modalities of dependence as collaboration and competition, providing a holistic understanding of dependence. Furthermore, I demonstrate that each mode of dependence allows for a bounded set of cross-field alliances through positive and negatively aligned hinges. The article demonstrates the explanatory power of these concepts through a historical comparative analysis of Iranian international student activism in 1970s and 2020s in the United States when Iran and the United States have vastly different relationships. Students in the 1970s were functionally challengers in the United States political field with directly targeting the United States government, joining domestic challenger networks, echoing domestic challenger narratives in their framing, and ultimately experiencing repression from a joint operation by home-state and host-state. In the 2020s, Iranian students were functionally incumbents in the United States, with legitimizing the United States narrative on Iran, excluding themselves from domestic challengers, and ultimately receiving support from the United States government.},
  langid = {english},
