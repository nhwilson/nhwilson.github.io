@article{krauseScientificityScientismInvention2024,
  title = {Scientificity before {{Scientism}}: {{The Invention}} of {{Cultural Research}} in {{German Studies}} of {{Antiquity}} 1800–1850},
  shorttitle = {Scientificity before {{Scientism}}},
