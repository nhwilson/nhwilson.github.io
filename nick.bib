@article{downeyKidsTheseDays2020,
  title = {Kids {{These Days}}: {{Are Face-to-Face Social Skills}} among {{American Children Declining}}?},
  shorttitle = {Kids {{These Days}}},
  author = {Downey, Douglas B. and Gibbs, Benjamin G.},
  date = {2020-01},
  journaltitle = {American Journal of Sociology},
  volume = {125},
