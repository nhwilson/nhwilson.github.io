@article{guzmanHistoricalSociologyCanonization2023,
  title = {Toward a {{Historical Sociology}} of {{Canonization}}: {{Comparing}} the {{Development}} of {{Sociological Theory}} in the {{English-}}, {{German-}}, and {{French-Language Contexts}} since the 1950s},
