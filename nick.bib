  pagetotal = {382},
  keywords = {History / World,Social Science / Disease & Health Issues,Social Science / Sociology / General},
  file = {/run/media/nick/data/Zotero/storage/NTQUXH6H/White_2023_Epidemic Orientalism.pdf}
