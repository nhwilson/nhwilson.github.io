@article{hillMarriageableMenWant2022,
  title = {Do the {{Marriageable Men}} Want to {{Protect}} and {{Provide}}? {{The Expectation}} of {{Black Professional Hybrid Masculinity}}},
  shorttitle = {Do the {{Marriageable Men}} Want to {{Protect}} and {{Provide}}?},
  author = {Hill, Marbella Eboni},
  date = {2022-08-01},
  journaltitle = {Gender \& Society},
  volume = {36},
