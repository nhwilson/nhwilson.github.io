@article{padgettOrganizationalInventionElite2006,
  title = {Organizational {{Invention}} and {{Elite Transformation}}: {{The Birth}} of {{Partnership Systems}} in {{Renaissance Florence}}},
  shorttitle = {Organizational {{Invention}} and {{Elite Transformation}}},
  author = {Padgett, John~F. and McLean, Paul~D.},
  date = {2006-03-01},
