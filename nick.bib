  urldate = {2023-07-05},
  abstract = {Histories of Sociology have become increasingly popular in recent decades, particularly national histories of Sociology, yet there have been few attempts to articulate a methodology and methods appropriate for the tasks at hand. This chapter examines the History of Sociology as a speciality of the discipline, defining its boundaries and tracing its own history. It investigates many national histories of sociology to ascertain their methods and methodologies, and reveals the extent to which these engage with existing methods and methodologies as found in the disciplines of Sociology and History, but also their related specialities, including the History of Ideas and History of Intellectuals, as well as Historical Sociology, the Sociology of Science, the Sociology of Ideas, the Sociology of Intellectuals, the Sociology of Institutions, and the Sociology of Knowledge. This systematic review suggests the subspecialty has recently shifted from an emphasis on the Sociology of Ideas to a Sociology of Institutions, and begun to adopt, albeit implicitly, the principles of the Sociology of Knowledge in its increasing acknowledgement of the shaping of Sociology’s terrain by the geo-socio-political context.},
  isbn = {978-981-15-4106-3},
