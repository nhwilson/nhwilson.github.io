  shorttitle = {Integrating {{Theories}} of {{Gender}} and {{Sexuality With Deviance}}},
  author = {Frizzell, Laura C. and Vuolo, Mike and Kelly, Brian C.},
  date = {2021-10-01},
  journaltitle = {Gender \& Society},
  volume = {35},
