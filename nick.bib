@article{stojmenovskaGenderGapWorkplace2021,
  title = {Gender {{Gap}} in {{Workplace Authority}}: {{Variation}} across {{Types}} of {{Authority Positions}}},
  shorttitle = {Gender {{Gap}} in {{Workplace Authority}}},
  author = {Stojmenovska, Dragana and Steinmetz, Stephanie and Volker, Beate},
  date = {2021-12},
