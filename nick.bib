@article{nordstromNewYorkSlave1980,
  title = {The {{New York Slave Code}}},
  author = {Nordstrom, Carl},
  date = {1980-01-31},
  journaltitle = {Afro - Americans in New York Life and History (1977-1989)},
  volume = {4},
  number = {1},
  pages = {7},
  publisher = {Afro-American Historical Association of the Niagara Frontier},
  location = {New York, United States},
  issn = {03642437},
  url = {https://www.proquest.com/docview/219940248/abstract/227139F45D614D6DPQ/1},
  urldate = {2022-07-24},
  abstract = {Slavery, thus, did not become a subject for special legislation in New York until the administration of the infamous Lord Cornbury in 1702. On November 27th of that year the provincial Assembly approved Chapter 123 of the New York Colonial Laws, "An Act for the regulating of slaves." This act, originally intended as a temporary expedient, was revised in 1705 and again in 1719. Violent outbreaks by slaves in 1708 and 1712 occasioned two other important slave acts. These were Chapter 181, "An Act for preventing the conspiracy of slaves," and Chapter 250, "for preventing, suppressing, and punishing the conspiracy and insurrection of Negroes and other slaves." Subsequently, Chapter 250 was modified twice. Finally, in 1730, the several slave statutes were drawn together into a permanent omnibus act which was designated Chapter 560 of the Colonial Laws. Chapter 560 achieves its comprehensive purpose as an omnibus slave law at the expense of consistency, and in other sections the slaves are frequently addressed directly. This was especially true of those provisions concerned with public safety. Noting that slaves had often been guilty of confederating, of running away, and of similar "dangerous" practice, the law prohibited the congregation of "above three slaves" except when they were engaged in servile employment with their master's consent and for his profit. Possession of a gun, pistol, sword, club, or any other kind of weapon was illegal for slaves. Slaves found guilty of such possession were subject to whippings of up to 40 lashes. Each city and town was empowered to appoint a Common Whipper for the slaves, with his salary to be paid by the master at so much per whipping. Assault by a slave on any Christian or Jew was also proscribed and carried with it a prison sentence in addition to the standard dose of corporal punishment. Chapter 250 repeates without additional malice many of the provisions introduced earlier in 123 and 181. In several entirely new sections, however, especially in those treating with the emancipation of slaves, the animus becomes only too apparent. Prior to the enactment of Chapter 250 the manumission of a slave had not been subject to legal regulation. Commonly, it had been thought to be a private matter between the master and the slave. This "laissez-faire" approach was, in fact, presumed to have been an important mechanism for maintaining the slave's interest in his service. [Edgar J. McManus], for example, contends that masters frequently promised manumission to slaves as a reward for faithful service and as an incentive to work. Some ingenious slaves, he continues, had prior to the enactment of Chapter 250 even arranged for their own manumission. But, after that act became law, emancipation was no longer left to the generous impulse, to the honest recognition of conscientious performance, or to the ingenuity and imagination of the slave, himself. Instead, severe restrictions on the practice were imposed.},
  langid = {english},
  pagetotal = {7},
  keywords = {African American/Caribbean/African,Bias,Civil law,Civil rights,Crime,Ethnic Interests,Hate crimes,History,Law,Legislation,Public policy,Slavery,Social services}
}

@article{norrisWhiteMenCant2022,
  title = {White {{Men Can}}'t {{Jump}}, but {{Does It Even Matter}}? {{Exit Discrimination}} in the {{NBA}}},
  shorttitle = {White {{Men Can}}'t {{Jump}}, but {{Does It Even Matter}}?},
  author = {Norris, Davon and Moss-Pech, Corey},
  date = {2022-03},
  journaltitle = {Social Forces},
  volume = {100},
  number = {3},
  pages = {961--989},
  issn = {00377732},
  doi = {10.1093/sf/soab009},
  url = {http://proxy.library.stonybrook.edu/login?url=https://search.ebscohost.com/login.aspx?direct=true&db=eue&AN=155335202&site=ehost-live},
  urldate = {2023-03-11},
  abstract = {Diffuse status characteristics, such as race and gender, affect individuals' professional opportunities and outcomes. Scholars suggest two possible explanations for these status disparities. First, uncertainty in measuring workers' performances forces employers to rely on status as a heuristic or proxy for quality. Second, a history of racism and sexism in the United States creates a deeper cultural devaluation of low-status individuals that permeates organizational structures such that status advantage would persist even after accounting for observed worker performance. However, researchers struggle to accurately and objectively measure worker performance, making it difficult to adjudicate between these two perspectives. We overcome this problem using the case of the National Basketball Association (NBA) in which detailed player statistics are widely available to the public and decision makers. We analyze whether there is a racial disparity in the odds of exiting the league using discrete-time event history analysis. Using data from 1980–2017, we demonstrate that after accounting for player performance, Black players have 30\% higher odds of exiting the league in a given season. We find this disparity is mostly driven by White bench players allowing us to elucidate how Whiteness operates as a credential in the NBA by giving marginal White players benefits such as longer careers than comparable Black players. These findings demonstrate that racial disparities in workplaces may persist even once performance is captured and in cases like the NBA where we might expect racial disparities to be minimized.},
  keywords = {Basketball,Basketball players,jour:: sf,National Basketball Association,Race discrimination in sports,Race relations in the United States,Racism,Social status},
  file = {/run/media/nick/data/Zotero/storage/IIF2MW5J/Norris_Moss-Pech_2022_White Men Can't Jump, but Does It Even Matter2.pdf;/run/media/nick/data/Zotero/storage/JHKX5WJB/Norris_Moss-Pech_2022_White Men Can't Jump, but Does It Even Matter.pdf}
}

