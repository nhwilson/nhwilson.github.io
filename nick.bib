@article{labriolaClassInequalityParental2021,
  title = {Class {{Inequality}} in {{Parental Childcare Time}}: {{Evidence}} from {{Synthetic Couples}} in the {{ATUS}}},
  shorttitle = {Class {{Inequality}} in {{Parental Childcare Time}}},
  author = {LaBriola, Joe and Schneider, Daniel},
  date = {2021-12},
  journaltitle = {Social Forces},
  volume = {100},
