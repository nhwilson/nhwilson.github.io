@article{denckerRentSeekingTransformation2016,
  title = {Rent {{Seeking}} and the {{Transformation}} of {{Employment Relationships}}: {{The Effect}} of {{Corporate Restructuring}} on {{Wage Patterns}}, {{Determinants}}, and {{Inequality}}},
  shorttitle = {Rent {{Seeking}} and the {{Transformation}} of {{Employment Relationships}}},
  author = {Dencker, John C. and Fang, Chichun},
  date = {2016},
  journaltitle = {American Sociological Review},
