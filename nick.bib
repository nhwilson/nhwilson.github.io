@article{davisUNDOINGVIOLENCEMANOSPHERE2024,
  title = {{{UNDOING VIOLENCE IN THE MANOSPHERE}}: {{INCELS}}’ {{DISENGAGEMENT FROM EXTREMISM IN DIGITAL FREE SPACE}}},
  shorttitle = {{{UNDOING VIOLENCE IN THE MANOSPHERE}}},
  author = {Davis, Alyssa J. and Kettrey, Heather Hensman},
  date = {2024-01-03},
