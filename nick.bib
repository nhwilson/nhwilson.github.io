  shorttitle = {Selfish or {{Substituting Spirituality}}?},
  author = {Kucinskas, Jaime and Stewart, Evan},
  date = {2022-08-01},
  journaltitle = {American Sociological Review},
  shortjournal = {Am Sociol Rev},
