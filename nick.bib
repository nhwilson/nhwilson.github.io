@article{feldmanCultureObjectivityQuantification2004,
  title = {The {{Culture}} of {{Objectivity}}: {{Quantification}}, {{Uncertainty}}, and the {{Evaluation}} of {{Risk}} at {{NASA}}},
  shorttitle = {The {{Culture}} of {{Objectivity}}},
  author = {Feldman, Steven P.},
