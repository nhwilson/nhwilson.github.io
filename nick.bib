@article{leiWhatDoesIt2021,
  title = {What {{Does}} It {{Take}} to {{Get Ahead}}? {{Individual Characteristics}}, {{Community Contexts}}, and {{Stratification Beliefs}} among {{Youth}} in {{China}}},
