@article{obrienReexaminingRestructuringRacialization2020,
  title = {Re-Examining {{Restructuring}}: {{Racialization}}, {{Religious Conservatism}}, and {{Political Leanings}} in {{Contemporary American Life}}},
  shorttitle = {Re-Examining {{Restructuring}}},
  author = {O'Brien, John and Abdelhadi, Eman},
  date = {2020},
  journaltitle = {Social Forces},
  volume = {99},
