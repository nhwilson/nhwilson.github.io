@article{limGlobalFieldsInstitutional2021,
  title = {Global {{Fields}}, {{Institutional Emergence}}, and the {{Regulation}} of {{Transnational Corporations}}},
  author = {Lim, Alwyn},
  date = {2021-03},
  journaltitle = {Social Forces},
  volume = {99},
  number = {3},
  pages = {1060--1085},
