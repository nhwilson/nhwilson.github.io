}

@article{sauerCategoricalDistinctionsClaimsMaking2021,
  title = {Categorical {{Distinctions}} and {{Claims-Making}}: {{Opportunity}}, {{Agency}}, and {{Returns}} from {{Wage Negotiations}}},
