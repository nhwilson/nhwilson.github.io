  doi = {10.1177/0003122418811264},
  url = {http://journals.sagepub.com/doi/10.1177/0003122418811264},
  urldate = {2024-09-15},
  abstract = {Why did France influence the geopolitical system of eighteenth-century Europe more effectively than did Britain? Explanations pointing to states’ military and economic power are unable to explain this outcome. I argue that durable geopolitical influence depends on states’ symbolic capacities to secure recognition from competitor states, in addition to their coercive and economic capacities. And I show that states are liable to secure recognition to the extent that their agents embody social dispositions congruent with those of competitor agents. France converted military and economic power into durable influence in eighteenth-century Europe because French agents and most of their European counterparts shared courtly standards of competence, and they were invested in the common stakes of patrimonial sovereignty. By contrast, Britain failed to convert its greater material power into similar influence because British agents tended to lack courtly manners and they were uninterested in patrimonial stakes.},
  langid = {english},
  keywords = {18th century European history,comparative/historical sociology,France -- Foreign relations,geopolitical influence,Great Britain -- Foreign relations -- 18th century,Great powers (International relations),habitus,Habitus (Sociology),History of diplomacy,practice,Recognition (International law),states},
  file = {/run/media/nick/data/Zotero/storage/539JHEIT/Brundage_2018_The Social Sources of Geopolitical Power.pdf;/run/media/nick/data/Zotero/storage/I3XK7H4Q/Brundage_2018_The Social Sources of Geopolitical Power.txt;/run/media/nick/data/Zotero/storage/MVH2Z9EC/Stuart Brundage - 2018 - The Social Sources of Geopolitical Power French and British Diplomacy and the Politics of Interstat.pdf}
}

@article{stuartCodeTweetUrban2020,
  title = {Code of the {{Tweet}}: {{Urban Gang Violence}} in the {{Social Media Age}}},
