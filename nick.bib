@book{turkmenBannerIslamTurks2021,
  title = {Under the {{Banner}} of {{Islam}}: {{Turks}}, {{Kurds}}, and the {{Limits}} of {{Religious Unity}}},
  shorttitle = {Under the {{Banner}} of {{Islam}}},
