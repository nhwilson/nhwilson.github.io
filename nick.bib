@article{abbotDefenseMeritScience2023,
  title = {In {{Defense}} of {{Merit}} in {{Science}}},
  author = {Abbot, D. and Bikfalvi, A. and Bleske-Rechek, A. L. and Bodmer, W. and Boghossian, P. and Carvalho, C. M. and Ciccolini, J. and Coyne, J. A. and Gauss, J. and Gill, P. M. W. and Jitomirskaya, S. and Jussim, L. and Krylov, A. I. and Loury, G. C. and Maroja, L. and McWhorter, J. H. and Moosavi, S. and Schwerdtle, P. Nayna and Pearl, J. and Quintanilla-Tornel, M. A. and Iii, H. F. Schaefer and Schreiner, P. R. and Schwerdtfeger, P. and Shechtman, D. and Shifman, M. and Tanzman, J. and Trout, B. L. and Warshel, A. and West, J. D.},
