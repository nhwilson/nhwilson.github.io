@article{keucheniusIntersectionalityGoDiffusion2021,
  title = {Intersectionality on the Go: {{The}} Diffusion of {{Black}} Feminist Knowledge across Disciplinary and Geographical Borders},
  shorttitle = {Intersectionality on the Go},
  author = {Keuchenius, Anna and Mügge, Liza},
  date = {2021-03},
  journaltitle = {The British Journal of Sociology},
  shortjournal = {British Journal of Sociology},
  volume = {72},
  number = {2},
