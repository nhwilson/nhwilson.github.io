@article{danermarkMethodologicalGuidelinesApplied,
  title = {Some {{Methodological Guidelines}} for {{Applied Critical Realist Research}}},
  author = {Danermark, Berth},
  abstract = {The purpose of the presentation is to contribute to concrete applied social research from a critical realist perspective. There are two major challenges in social research. The first is that social phenomenon are produced in open systems and determined and influenced by a complex set of structures and mechanisms. The second challenge is to go from individual observation to a more general knowledge and vice versa. There are two different meanings of inference: as it is treated in formal logic, and as thought operations, i.e. different ways of reasoning and thinking in order to proceed from something to something else. Critical realism has much to offer regarding both the issue of complexity and inference. Complexity is approached by introducing interdisciplinary research. Inference is addressed by four modes of inference (deduction, induction, abduction, and retroduction). Their strengths and shortcomings are discussed. Social science investigations need all four approaches. They are complementary. However, the weakness of deduction is that it does not tell us anything new; the weakness of induction is that it does not tell us anything about causality (only descriptive empirical generalisations). Abduction is a kind of redescription/recontextualisation giving new meaning to already known phenomenon. Retroduction is to ask the transfactual question “What makes X possible?” The paper presents ten methodological guidelines, based on critical realism.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/SSFA93C3/Danermark - Some Methodological Guidelines for Applied Critical Realist Research.pdf}
}

