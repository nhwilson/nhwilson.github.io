@article{boyersSUBVERSIONSOCIOLOGICALCANON,
  title = {{{SUBVERSION AND THE SOCIOLOGICAL CANON}}},
  author = {Boyers, Jennifer S},
  abstract = {This paper is a review of the suppressed works of three early women social theorists and activists. It is based on the research of contemporary sociologists who have striven to uncover and bring to light the work of our sociological foremothers. The author takes the view that we must focus on how the institutionalization of sociology and other social sciences actively suppressed the works of these women. But, it is stressed, we must also remember that these classical women social scientists were active agents who were, at times, able to subvert the very process of canonization. The author incorporates the descriptive work of others - including Rynbrandt and Richardson, who are also featured in this Symposium - to call for the inclusion of the work of these earlier women into the existing sociological canon and for restructuring the discipline in light of these subversive, silenced voices. Other contemporary theorists - namely Mary Jo Deegan, Patricia Lengermann, and Jill Niebrugge-Brantley - are pioneers in doing this kind of work. But it is worth reiterating their observations in this forum, as we continue to recover and hopefully to integrate the lost works of classical women social theorists.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/VWV6QYHG/Boyers - SUBVERSION AND THE SOCIOLOGICAL CANON.pdf}
}

