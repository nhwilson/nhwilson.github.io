@article{hobsonHistoricalSociologyState1998,
  title = {The {{Historical Sociology}} of the {{State}} and the {{State}} of {{Historical Sociology}} in {{International Relations}}},
  author = {Hobson, John M.},
  date = {1998},
  journaltitle = {Review of International Political Economy},
  volume = {5},
  number = {2},
  eprint = {4177267},
  eprinttype = {jstor},
  pages = {284--320},
  publisher = {Taylor \& Francis, Ltd.},
  issn = {0969-2290},
  url = {https://www.jstor.org/stable/4177267},
  urldate = {2023-03-06},
  abstract = {With the current concern to critique neorealism, international relations (IR) theorists are looking to a variety of new perspectives as a way forward. Various authors have taken a specific interest in Weberian historical sociology (WHS), outlined in the works of Michael Mann and others. Nevertheless, there is currently only a rudimentary understanding of the approach within IR, and perhaps even less understanding of how it can be applied to IR. There is also a growing perception that the approach is inherently realist. This article seeks to redress this. It begins by laying out the basic WHS approach by identifying six general principles or traits. Special emphasis is given to recent developments in WHS's theory of state autonomy, which takes the approach beyond neorealism. Having considered how this approach overlaps with the concerns of various IR theorists, notably Linklater, Halliday and others, it proceeds to examine how the approach can take IR beyond neorealism, by applying it to understanding: international economic change through a historical examination of tariff protectionism and free trade; the international politics of states, war and revolution; and international systems change (namely European industrialization). It concludes with a possible historical sociology research agenda for the study of IR.},
  file = {/run/media/nick/data/Zotero/storage/DPHC2LV3/Hobson_1998_The Historical Sociology of the State and the State of Historical Sociology in.pdf}
}

