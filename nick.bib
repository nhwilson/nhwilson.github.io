@article{apterHistoryDungeonAtlantic2017,
  title = {History in the {{Dungeon}}: {{Atlantic Slavery}} and the {{Spirit}} of {{Capitalism}} in {{Cape Coast Castle}}, {{Ghana}}},
  shorttitle = {History in the {{Dungeon}}},
  author = {Apter, Andrew},
  date = {2017},
  journaltitle = {The American Historical Review},
  volume = {122},
