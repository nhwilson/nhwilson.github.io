  title = {Conjunctural {{Analysis}}},
  booktitle = {International {{Encyclopedia}} of {{Geography}}},
  author = {Sheppard, Eric and Leitner, Helga and Peck, Jamie},
  editor = {Richardson, Douglas and Castree, Noel and Goodchild, Michael F. and Kobayashi, Audrey and Liu, Weidong and Marston, Richard A.},
  date = {2024-09-18},
