@article{bukodiIntergenerationalClassMobility2020,
  title = {Intergenerational {{Class Mobility}} in {{Europe}}: {{A New Account}}},
  shorttitle = {Intergenerational {{Class Mobility}} in {{Europe}}},
  author = {Bukodi, Erzsébet and Paskov, Marii and Nolan, Brian},
  date = {2020},
  journaltitle = {Social Forces},
  volume = {98},
  number = {3},
  pages = {941--972},
  publisher = {Oxford University Press},
  issn = {1534-7605},
  url = {https://muse.jhu.edu/pub/8/article/750455},
  urldate = {2023-03-18},
  abstract = {Comparative research into intergenerational social mobility has been typically restricted to a relatively small number of countries. The aim of this paper is to widen the perspective, and to provide an up-to-date account of rates of inter-generational class mobility across 30 European countries, using a newly-constructed comparative data-set based on the European Social Survey. Absolute mobility rates are found to vary quite widely with national differences in the extent and pattern of class structural change. As regards relative rates, countries are best seen as falling into groups within comparatively high and low fluidity sets, within which groups a high degree of cross-national commonality prevails. Further results indicate that country differences in relative rates play only a very limited part in accounting for country differences in absolute rates, confirming that the latter are primarily determined by class structural change. Based on our findings, we suggest a restatement of the FJH-hypothesis to the effect that in societies with a capitalist market economy, a nuclear family system and a liberal-democratic polity, a limit exists to the extent to which relative rates of class mobility can be equalized, which countries may move closer to or, in the case of post-socialist societies, recede from.},
  keywords = {absolute rates,comparative class mobility,Europe,FJH-hypothesis,jour:: sf,relative rates},
  file = {/run/media/nick/data/Zotero/storage/MMY59GS2/Bukodi et al_2020_Intergenerational Class Mobility in Europe.pdf}
}

