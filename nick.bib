@article{nelsonTheoryPracticeBack2021,
  title = {From {{Theory}} to {{Practice}} and {{Back}}: {{How}} the {{Concept}} of {{Implicit Bias}} Was {{Implemented}} in {{Academe}}, and {{What}} This {{Means}} for {{Gender Theories}} of {{Organizational Change}}},
