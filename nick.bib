@article{olsenMixingStatisticalMethods,
  title = {Mixing {{Statistical Methods}} and {{Social Ontology}} in {{Social Science Research}}},
  author = {Olsen, Wendy},
  abstract = {I develop retroduction for research including social statistics. Social ontology helps us discern valid claims and develop warranted arguments. I discuss how claims are built upon a mixture of induction, deduction and retroduction. I advocate mixed methods and being aware of the ontic assumptions one is making. A key moment is when a team reviews its ontology to re-visit and re-frame how something – either an entity, an institution, or a process – has been conceived of. The retroductive moment is one of these three: Either ask what must the world be like for these data to have emerged; or ask what could the linkages of past to future be like for these data to be consistent with my vision for the future? Or ask what norms and discourses in society have underpinned the creation of the data, such that it appears to us like this? I critically assess two exemplars, one by an applied social statistician and one by Bayesian statisticians, to illustrate.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/GQLTL8Z8/Olsen - Mixing Statistical Methods and Social Ontology in Social Science Research.pdf}
}

