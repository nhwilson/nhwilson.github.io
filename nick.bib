@article{kamranPatchworkFemininitiesWorkingClass2021,
  title = {A {{Patchwork}} of {{Femininities}}: {{Working-Class Women}}’s {{Fluctuating Gender Performances}} in a {{Pakistani Market}}},
  shorttitle = {A {{Patchwork}} of {{Femininities}}},
  author = {Kamran, Sidra},
  date = {2021-12-01},
  journaltitle = {Gender \& Society},
  volume = {35},
