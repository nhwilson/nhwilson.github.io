@article{racineProxyPastsUse2017,
  title = {Proxy {{Pasts}}: {{The Use}} of {{British Historical References}} in {{Spanish American Independence Rhetoric}}, 1808–1828},
  shorttitle = {Proxy {{Pasts}}},
