@article{collinsSurvivingClosurePostRejection2000,
  title = {Surviving {{Closure}}: {{Post-Rejection Adaptation}} and {{Plurality}} in {{Science}}},
  shorttitle = {Surviving {{Closure}}},
  author = {Collins, H. M.},
  date = {2000},
  journaltitle = {American Sociological Review},
  volume = {65},
  number = {6},
