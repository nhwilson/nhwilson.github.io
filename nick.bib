@article{linExaminingBiasLarge,
  title = {Examining {{Bias}} in {{Large Language Models}} on {{Child Maltreatment}}: {{Representational Bias}}, {{Allocative Bias}}, and {{Output Homogeneity}}},
  author = {Lin, Hao},
  abstract = {How may technology exacerbate the vulnerable status of the individuals? Despite strict regulations, AI-based decision-making tools are increasingly used in child welfare, offering both significant promise and challenges. One major concern is algorithmic bias embedded in large language models (LLMs), which often reflect existing social disparities. This study empirically investigates representational bias, allocative bias, and output homogeneity in LLMs related to child maltreatment. We adopted a behavioral approach by using prompt-based queries simulating real-world child welfare cases and extracting key information from LLMs’ outputs for statistical analysis. It shows that LLMs overrepresent certain demographic groups, overemphasize severe maltreatment forms, such as physical abuse, over neglect cases which are the most common form according to national data, and consistently predict higher risk scores to children from low-income families. Moreover, the narratives are highly homogeneous in LLMgenerated content. Thus, it shows that each LLM has a biased but highly centralized representation of child maltreatment. By providing empirical evidence on LLMs behavior in child maltreatment, this study contributes to the ongoing discussions about responsible AI use in high-stake domains and highlights the importance of systematic evaluation of algorithms before deploying algorithms to avoid reinforcing societal biases and inequities.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/RDG4BAHQ/HLin_trackpaper2_0403-1.pdf}
}

@article{linGoverningNaturalDisasters2015,
  title = {Governing {{Natural Disasters}}: {{State Capacity}}, {{Democracy}}, and {{Human Vulnerability}}},
  shorttitle = {Governing {{Natural Disasters}}},
  author = {Lin, Thung-Hong},
  date = {2015-03-01},
  journaltitle = {Social Forces},
  shortjournal = {Social Forces},
  volume = {93},
  number = {3},
  pages = {1267--1300},
  issn = {0037-7732},
  doi = {10.1093/sf/sou104},
  url = {https://doi.org/10.1093/sf/sou104},
  urldate = {2023-04-21},
  abstract = {From the perspective of historical institutionalism, I argue that state capacity, democracy, and their interaction shape the distribution of human vulnerability in natural disasters. The ruling elite, irrespective of whether it is democratic, has the incentive to develop state capacity to prevent damage caused by natural disasters, which is considered a threat to its rule and revenue. To win elections in a democracy, the elite may increase public spending for disaster mitigation in favor of voters' demands. Democracy also empowers civil society and stimulates social spending, which benefits vulnerable citizens. Thus, a strong state capacity effectively reduces human vulnerability, especially in a democracy. I used panel data from 150 countries between 1995 and 2009 to demonstrate the relationship among state capacity, democracy, and the impact of disasters. After controlling for the density and magnitude continuity of natural-disaster hazards, the empirical results I obtained from the multilevel models indicate that democracy reduces the disaster mortality rate, and a strong state capacity mitigates the effect of a disaster on a population, especially in a democracy. I also found that state capacity and democracy are more effective in preventing human losses caused by predictable disasters such as floods and storms, rather than earthquakes.}
}

