  shorttitle = {White {{Supervisor}} and {{Subordinate Beliefs}} about {{Black}}/{{White Inequality}}},
  author = {Smith, Ryan A and Hunt, Matthew O},
  date = {2021-08-01},
  journaltitle = {Social Problems},
  shortjournal = {Social Problems},
  volume = {68},
  number = {3},
