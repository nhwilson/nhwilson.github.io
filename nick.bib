@article{smithEvolutionaryPsychologyPossible2020,
  title = {Is {{Evolutionary Psychology Possible}}?},
  author = {Smith, Subrena E.},
  date = {2020-03},
  journaltitle = {Biological Theory},
  shortjournal = {Biol Theory},
  volume = {15},
