@article{martinez-schuldtImmigrantSanctuaryPolicies2021,
  title = {Immigrant {{Sanctuary Policies}} and {{Crime-Reporting Behavior}}: {{A Multilevel Analysis}} of {{Reports}} of {{Crime Victimization}} to {{Law Enforcement}}, 1980 to 2004},
