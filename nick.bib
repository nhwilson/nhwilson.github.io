@article{luVerticalEducationOccupationMismatch2021,
  title = {Vertical {{Education-Occupation Mismatch}} and {{Wage Inequality}} by {{Race}}/{{Ethnicity}} and {{Nativity}} among {{Highly Educated US Workers}}},
  author = {Lu, Yao and Li, Xiaoguang},
  date = {2021-12},
  journaltitle = {Social Forces},
