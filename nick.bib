@article{fischerSocialExclusionResilience2022,
  title = {Social {{Exclusion}} and {{Resilience}}: {{Examining Social Network Stratification}} among {{People}} in {{Same-Sex}} and {{Different-Sex Relationships}}},
  shorttitle = {Social {{Exclusion}} and {{Resilience}}},
  author = {Fischer, Mirjam M},
