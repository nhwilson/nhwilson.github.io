@article{kalbergRationalizationActionMax1990,
  title = {The {{Rationalization}} of {{Action}} in {{Max Weber}}'s {{Sociology}} of {{Religion}}},
  author = {Kalberg, Stephen},
  date = {1990},
  journaltitle = {Sociological Theory},
  volume = {8},
  number = {1},
  eprint = {202195},
