  urldate = {2023-05-26},
  abstract = {Papers published in economics journals whose first authors are famous have more citations than papers whose second or third authors are famous. As a paper ages, its citation rate varies most with variation in the fame of the first author and less so with the fame of second and third authors. Author order is alphabetical so these patterns are unrelated to underlying quality. The magnitudes we find are large: a three-author paper written by the most prolific author in economics and his two research assistants would receive, on average, more than double the citations if the prolific author were first rather than second or third. The effect is especially pronounced in three, rather than two, author papers, suggesting that burying a famous author in the “et al” reduces citations even further.},
