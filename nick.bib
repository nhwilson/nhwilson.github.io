  doi = {10.1086/676041},
  url = {https://www.journals.uchicago.edu/doi/10.1086/676041},
  urldate = {2024-09-15},
  abstract = {How do states produce coercive power? Often this question is answered with reference to organizational structure and to the motivating logic of distributional effects. The paper argues that coercive power also relies on a cultural infrastructure. Taking the destruction of piracy in the English maritime system at the beginning of the eighteenth century as its empirical case, the first part of the paper shows that despite sufficient material and organizational resources to wage international war, coercive power against piracy eluded English state agents for decades. By comparing coercive power against piracy before and after key legal reforms of 1701, the paper shows that the main achievement of the reforms was the creation of new powers of classification that enabled the effective coordination of coercive power against piracy. The second part of the paper develops this argument further by proposing the general theoretical mechanisms of collective representation and social performance to account for the efficacy of new powers of classification in coordinating coercive power. It argues that social coordination relies on individual performative actions that assert the meaning of people, things, and interactions in terms of a matrix of collective representations.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/MVW7JS4L/Norton_2014_Classification and Coercion.pdf;/run/media/nick/data/Zotero/storage/VQY4LUGE/Norton - 2014 - Classification and Coercion The Destruction of Piracy in the English Maritime System.pdf}
}

