@article{reevesDeclinePersistenceOld2017,
  title = {The {{Decline}} and {{Persistence}} of the {{Old Boy}}: {{Private Schools}} and {{Elite Recruitment}} 1897 to 2016},
  shorttitle = {The {{Decline}} and {{Persistence}} of the {{Old Boy}}},
  author = {Reeves, Aaron and Friedman, Sam and Rahal, Charles and Flemmen, Magne},
  date = {2017},
  journaltitle = {American Sociological Review},
  volume = {82},
  number = {6},
  eprint = {26426365},
