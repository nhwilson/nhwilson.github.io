@book{harlingWaningOldCorruption1996,
  title = {The {{Waning}} of '{{Old Corruption}}': {{The Politics}} of {{Economical Reform}} in {{Britain}}, 1779-1846},
  shorttitle = {The {{Waning}} of '{{Old Corruption}}'},
  author = {Harling, Philip},
  date = {1996},
  publisher = {Oxford University Press},
  location = {Oxford},
  abstract = {Most historians of Britain now take for granted that a narrow and mostly landed elite managed to retain its social supremacy throughout much of the nineteenth century. But as yet, there is no thorough explanation for the persistence of the old elite's political authority in an age when that authority was seriously questioned by many Britons. In this original study, Philip Harling furnishes an important part of this explanation. He argues that the mostly Pittite governing elite helped to allay the suspicions of parasitism at the root of the familiar critique of 'Old Corruption' by responding to intense pressure to sanitize government. They did this by reducing and redistributing the tax burden; by eliminating serious administrative abuses such as the grant of lucrative sinecures and unmerited pensions; and by ostentatiously dedicating themselves to public business rather than the pursuit of wasteful privileges for themselves and their hangers-on. If the frugal, liberal state that partly resulted from these reforms was scarcely capable of ameliorating social injustice, at least it could no longer be seen to contribute to it through favouritism and a heavy and inequitable tax load. Such a state was well-suited for the preservation of a narrow ruling elite.},
  isbn = {978-0-19-820576-0},
  langid = {english},
  pagetotal = {328},
  keywords = {corruption,History / Europe / General,History / Europe / Great Britain,Political Science / Public Policy / Economic Policy}
}

