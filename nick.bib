@article{page-gouldUnderstandingImpactCrossgroup2010,
  title = {Understanding the Impact of Cross-Group Friendship on Interactions with Novel Outgroup Members.},
  author = {Page-Gould, Elizabeth and Mendoza-Denton, Rodolfo and Alegre, Jan Marie and Siy, John Oliver},
  date = {2010-05-01},
  journaltitle = {Journal of Personality and Social Psychology},
  shortjournal = {Journal of Personality and Social Psychology},
  volume = {98},
  number = {5},
