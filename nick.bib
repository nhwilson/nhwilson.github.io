  file = {/run/media/nick/data/Zotero/storage/GMR22NML/Lynn_Ellerbach_2017_A Position with a View.pdf}
}

@article{lynnRareCaseGender2019,
  title = {A {{Rare Case}} of {{Gender Parity}} in {{Academia}}},
