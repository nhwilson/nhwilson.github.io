@article{youngbloodBibliometricAnalysisInterdisciplinary2018,
  title = {A Bibliometric Analysis of the Interdisciplinary Field of Cultural Evolution},
  author = {Youngblood, Mason and Lahti, David},
  date = {2018-10-02},
  journaltitle = {Palgrave Communications},
  shortjournal = {Palgrave Commun},
  volume = {4},
  number = {1},
