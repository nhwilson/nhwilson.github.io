@book{wrennTrueGoodStrong2023,
  title = {The {{True}} and the {{Good}}: {{A Strong Virtue Theory}} of the {{Value}} of {{Truth}}},
  shorttitle = {The {{True}} and the {{Good}}},
  author = {Wrenn, Chase B.},
  date = {2023-12-14},
