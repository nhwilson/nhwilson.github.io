@article{ambuhlJoanArcPrisonniere2017,
  title = {Joan of {{Arc}} as Prisonnière de Guerre},
  author = {Ambühl, Rémy},
  date = {2017},
  journaltitle = {The English Historical Review},
  volume = {132},
