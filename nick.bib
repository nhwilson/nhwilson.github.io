@article{pareskyMechanicsRedistributionPrestige2026,
  title = {The Mechanics of Redistribution in a Prestige Economy},
  author = {Paresky, Pamela},
  date = {2026-06-19},
  journaltitle = {Theory and Society},
  shortjournal = {Theor Soc},
  volume = {55},
