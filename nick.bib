  doi = {10.1086/597179},
  url = {https://www.journals.uchicago.edu/doi/full/10.1086/597179},
  urldate = {2022-11-27},
  abstract = {This article presents a new model of culture in action. Although most sociologists who study culture emphasize its role in post hoc sense making, sociologists of religion and social psychologists tend to focus on the role beliefs play in motivation. The dual‐process model integrates justificatory and motivational approaches by distinguishing between “discursive” and “practical” modes of culture and cognition. The author uses panel data from the National Study of Youth and Religion to illustrate the model's usefulness. Consistent with its predictions, he finds that though respondents cannot articulate clear principles of moral judgment, their choice from a list of moral‐cultural scripts strongly predicts later behavior.},
  file = {/run/media/nick/data/Zotero/storage/9DSI9BHC/Vaisey_2009_Motivation and Justification2.pdf;/run/media/nick/data/Zotero/storage/UNNXMF8E/Vaisey_2009_Motivation and Justification3.pdf;/run/media/nick/data/Zotero/storage/VUQSNKN6/Vaisey_2009_Motivation and Justification.pdf;/run/media/nick/data/Zotero/storage/BCTCEV46/597179.html}
}

@article{vaiseyPaperAdaptedDissertation,
  title = {Paper Adapted from the Dissertation},
  author = {Vaisey, Stephen},
  abstract = {This paper moves toward a model for answering the question: What role do cultural beliefs play in behavior? Most sociologists of culture emphasize how people use culture to make sense of life, while most sociologists of religion focus on how beliefs motivate action. To overcome this contradiction, I offer a heuristic model based on sociological practice theories (Giddens and Bourdieu) and research in cognitive science that recognizes two primary levels of cognition—the discursive and the practical. I argue that the former is specialized for cultural justification while the latter is the site of unarticulated cultural motivations. This insight allows the development of a unified model that can account for the predictions of both justificatory and motivational approaches. Using qualitative and quantitative data from two waves of the National Study of Youth and Religion, I illustrate the empirical consistency and usefulness and of this dual-process model. The results show that though young people are largely unable to articulate a link between their beliefs and behavior, their survey responses to a general question about moral judgment are highly predictive of changes in behavior and network composition over time in ways consistent with the motivating power of unconscious belief.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/4CZJ7RZU/Vaisey - Paper adapted from the dissertation.pdf}
}

