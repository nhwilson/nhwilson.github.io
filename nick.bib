@article{strangInnerIncompatibilityEmpire1992,
  title = {The {{Inner Incompatibility}} of {{Empire}} and {{Nation}}: {{Popular Sovereignty}} and {{Decolonization}}},
  shorttitle = {The {{Inner Incompatibility}} of {{Empire}} and {{Nation}}},
  author = {Strang, David},
