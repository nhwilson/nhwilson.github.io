@article{decoteauScientificHegemonyField2020,
  title = {Scientific {{Hegemony}} and the {{Field}} of {{Autism}}},
  author = {Decoteau, Claire Laurier and Daniel, Meghan},
  date = {2020-06-01},
  journaltitle = {American Sociological Review},
  shortjournal = {Am Sociol Rev},
  volume = {85},
  number = {3},
  pages = {451--476},
  publisher = {SAGE Publications Inc},
  issn = {0003-1224},
  doi = {10.1177/0003122420922531},
  url = {https://doi.org/10.1177/0003122420922531},
  urldate = {2023-03-18},
  abstract = {Autism is one of the twenty-first century?s most contested illnesses. Early controversies around vaccine harm have irrevocably structured the field of autism science. Despite incredible investment in genetic research on autism over the past 30 years, scientists have failed to identify a set of ?genes for? autism, and genomic causality has become more complex. Yet, orthodox genetic explanations for autism have retained dominance over a vociferous field of heterodox experts pointing to a series of environmental insults (vaccines, heavy metal exposure, overuse of antibiotics, toxic pollution) as the main causes of autism. To make sense of this puzzling trend, we develop a novel theoretical synthesis combining a Bourdieusian field analysis with a Gramscian conception of hegemony, centered around the concept of ?subsumptive orthodoxy.? Analyzing multiple years of archival data from the Interagency Autism Coordinating Committee, we argue that when faced with heterodox challenges, dominant members of the field shore up hegemony by incorporating environmental causal factors into the genome, thus engaging in subsumptive orthodoxy. This move gives rhetorical space to environmental explanations without providing them substantive causal weight, which renders particular environmental causes (like vaccines) impossible. This article traces the strategies dominant members of the field use to retain control over the definition and etiology of autism. We develop the broader implications of the study within autism science and beyond.},
  langid = {english},
  keywords = {jour:: sf},
  file = {/run/media/nick/data/Zotero/storage/EMRPU6BR/Decoteau_Daniel_2020_Scientific Hegemony and the Field of Autism.pdf}
}

