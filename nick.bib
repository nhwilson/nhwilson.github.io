  pages = {203--206},
  issn = {0037-7791},
  doi = {10.1093/socpro/spab007},
  url = {https://doi.org/10.1093/socpro/spab007},
  urldate = {2023-03-18},
  abstract = {In the late 1990s an upstart and insurgent push arose in the discipline of sociology to expand the literature on the contributions of William Edward Burghardt (W. E. B.) Du Bois beyond cursory acknowledgments of his 1899 book Philadelphia Negro and his theories including “double consciousness” and the talented tenth. This new season of scholarship on Du Bois extends beyond these topical areas to provide exhaustive analyses of the momentous role he played in establishing scientific sociology in the United States.Significantly, Du Bois was a primary architect in the development of many empirical methodologies and theories, some of which would eventually become dominant in sociology. Prior to this current season of appreciation for Du Boisian sociology, there were scholars who worked toward infusing the works of Harvard’s first Black doctoral recipient into the all-white male sociological canon. Their mission was to promote the significance of Du Bois’ scholarship with the goal of its eventually becoming a cornerstone of mainstream sociology. Their efforts, however, were not fully successful. Early attempts to place Du Bois among the discipline's giants were unsuccessful because they focused largely on his theories, concepts, and fragmented urban and rural studies to the exclusion of the contributions Du Bois made during his tenure as an institutionally-affiliated faculty member and director of the annual research initiative at Atlanta University (Alien 1992; Appiah 1985; Blight 1990; Green and Driver 1976; Harrison 1992; Henderson 1976; Jones 1976; Lange 1983; Lemert 1994; Marable 1983 and 1985; Montiero 1994; Ramparsad 1976; Robinson 1990; Romero 1976; Stewart 1984; N. Warren 1984 and 2011).},
  keywords = {jour:: sp},
  file = {/run/media/nick/data/Zotero/storage/XXBHWYIM/Wright_Morris_2021_Introduction to the Special Issue.pdf;/run/media/nick/data/Zotero/storage/NPYW8V72/2.html}
