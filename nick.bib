}

@article{gonsalvesGenderIdentitySexed2020,
  title = {Gender {{Identity}}, the {{Sexed Body}}, and the {{Medical Making}} of {{Transgender}}},
  author = {Gonsalves, Tara},
  date = {2020-12-01},
  journaltitle = {Gender \& Society},
  volume = {34},
  number = {6},
