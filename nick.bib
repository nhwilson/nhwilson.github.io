@article{kimLowestLowFertilitySouth2020,
  title = {Lowest-{{Low Fertility}} in {{South Korea}}: {{Policy}} and {{Domestic Labor Supports}} and the {{Transition}} to {{Second Birth}}},
  shorttitle = {Lowest-{{Low Fertility}} in {{South Korea}}},
  author = {Kim, Joeun and Luke, Nancy},
  date = {2020},
