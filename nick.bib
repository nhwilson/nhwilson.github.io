  pages = {263--296},
  issn = {0003-9756, 1474-0583},
  doi = {10.1017/S0003975605000093},
  url = {https://www.cambridge.org/core/product/identifier/S0003975605000093/type/journal_article},
  urldate = {2024-09-15},
  abstract = {One of the fundamental ideational changes brought by modernity into Indian intellectual culture was the transformation in the idea of the state. From an institution that was traditionally seen as a necessarily limited and distinctly unpleasant part of the basic furniture of any society, the idea of the state has been transformed into that of a central moral force, producing an immense enchantment in India’s intellectual life. Indeed, in the Indian context, as distinct from the European one, it has been the primary source of modernity. This paper seeks to present an absurdly short history of the curious adventures of this idea. It also seeks to explain why, despite the global dominance of ideas of liberalisation, and a reduction of the state’s interference in social and economic life, in India this enchantment is still undiminished.           ,              Dans la modernisation de la culture des élites indiennes, un élément essentiel fut la transformation radicale de la représentation de l’État, passant du négatif au positif. De fait, l’État indien a été la force principale de modernisation. L’article présente brièvement les curieuses aventures de cette idée et tente d’expliquer comment, en dépit de la domination des idées libérales et d’une réduction des interventions étatiques dans la vie économique et sociale, l’enchantement pour l’État n’a, en Inde, aucunement diminué.           ,              Die Modernisierung der indischen Elite erfolgte wesentlich durch die Veränderung des Staatsbegriffs, von anfänglich negativ zu positiv. Der indische Staat wurde so zurtragenden KraftderModernisierung. Dieser Aufzatz skizziert kurz den Werdegang dieser kuriosen Entwicklung und erläutert die anhaltende Begeisterung für den Staat, trotz liberaler Tendenzen und einem Rückgang der staatlichen Eingriffe im sozialen Bereich und in der Politik.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/B2N4WGHS/Kaviraj - 2005 - On the enchantment of the state Indian thought on the role of the state in the narrative of moderni.pdf}
}

