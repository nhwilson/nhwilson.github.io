  title = {Education for {{All}}: {{How Schooling Is Creating Social Changes}} for {{Lowered-Caste Girls}} in {{Rural India}}},
  shorttitle = {Education for {{All}}},
  author = {Dejaeghere, Joan and Arur, Aditi Ashok},
  date = {2020-12-01},
  journaltitle = {Gender \& Society},
  volume = {34},
