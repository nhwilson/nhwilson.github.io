@article{steinmetzColonialStateSocial2008a,
  title = {The {{Colonial State}} as a {{Social Field}}: {{Ethnographic Capital}} and {{Native Policy}} in the {{German Overseas Empire}} before 1914},
  shorttitle = {The {{Colonial State}} as a {{Social Field}}},
  author = {Steinmetz, George},
  date = {2008-08},
  journaltitle = {American Sociological Review},
  shortjournal = {Am Sociol Rev},
  volume = {73},
  number = {4},
  pages = {589--612},
  issn = {0003-1224, 1939-8271},
  doi = {10.1177/000312240807300404},
  url = {https://journals.sagepub.com/doi/10.1177/000312240807300404},
  urldate = {2024-09-15},
  abstract = {What led modern colonizers to treat their subject populations in radically differing ways, ranging from genocide to efforts to “salvage” precolonial cultures? In Southwest Africa, Germany massacred the Ovaherero and Witbooi; in Samoa, Germany pursued a program of cultural retraditionalization; and in the Chinese leasehold colony of Qingdao/Kiaochow, the Germans moved from policies of racialized segregation to a respectful civilizational exchange. Bourdieu is not generally seen as a theorist of empire, despite the partial genesis of his lifelong research program in the late colonial crucible of French Algeria (Bourdieu 1958; Yacine 2004). Nonetheless, Bourdieu's theoretical work—most notably his conceptions of field and capital—helps solve the main riddle of the colonial state. Different European social groups competed inside the colonial state field for a specific form of symbolic capital: ethnographic capital. This involved exhibiting an alleged talent for judging the culture and character of the colonized, a gift for understanding “the natives.” Competitive dynamics among the colonial rulers decisively shaped the ongoing production of native policies. Policy formation was also influenced by geopolitical and economic interests, responses by the colonized, and the metropolitan government's final authority in appointing and dismissing colonial officials. The effects of these additional mechanisms were typically mediated by the internal dynamics of the semi-autonomous colonial state.},
  langid = {english},
  file = {/run/media/nick/data/Zotero/storage/AMJ5VY29/Steinmetz - 2008 - The Colonial State as a Social Field Ethnographic Capital and Native Policy in the German Overseas.pdf;/run/media/nick/data/Zotero/storage/G2N4Q2XR/Steinmetz - 2008 - The Colonial State as a Social Field Ethnographic Capital and Native Policy in the German Overseas.pdf}
}

@incollection{steinmetzComparativeHistoryIts2014,
  title = {Comparative {{History}} and {{Its Critics}}},
  booktitle = {A {{Companion}} to {{Global Historical Thought}}},
  author = {Steinmetz, George},
  date = {2014},
  pages = {412--436},
  publisher = {John Wiley \& Sons, Ltd},
  doi = {10.1002/9781118525395.ch27},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118525395.ch27},
  urldate = {2020-12-08},
  abstract = {Discussions of comparison in the human and social sciences are highly polarized between defenders and critics. This chapter aims to historicize the main positions on comparison as they have emerged over the longue durée of intellectual history. The first section reviews the evolution of comparative historiography from its origins in the ancient world to the present. The second section surveys the development of the most influential anti-comparative approach, nineteenth-century German historicism, as well a set of entangled historical approaches focused on transnational diffusion and imitation, blowback from overseas colonies, and the critique of the “logic of seriality”. The third section addresses the solution to the debate between historicists and anti-historicists that emerged around 1900 in the work of German philosophers like Heinrich Rickert and social scientists such as Max Weber. Rather than dropping comparativism or replacing it with transnationalism, this chapter tries to reframe the question of comparison.},
  isbn = {978-1-118-52539-5},
  langid = {english},
  keywords = {comparative historiography,critics,German historicism,intellectual history,Rickert,transnationalism,Weber},
  file = {/run/media/nick/data/Zotero/storage/98669ITG/Steinmetz_2014_Comparative History and Its Critics.pdf;/run/media/nick/data/Zotero/storage/L6UTWIQJ/9781118525395.html}
}

