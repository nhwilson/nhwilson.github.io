  author = {Fisher, Benjamin W and Higgins, Ethan M and Kupchik, Aaron and Viano, Samantha and Curran, F Chris and Overstreet, Suzanne and Plumlee, Bryant and Coffey, Brandon},
  date = {2022-05-01},
  journaltitle = {Social Problems},
