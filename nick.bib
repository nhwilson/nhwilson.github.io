  doi = {10.1002/fea2.12036},
  url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/fea2.12036},
  urldate = {2025-01-21},
  abstract = {The Cite Black Women movement has opened important possibilities for community building around citational politics and praxis. For white feminist anthropologists, reckoning with how whiteness has shaped the canon within feminist anthropology is particularly important. While this necessitates broader challenges to the racist and colonial legacies within anthropology, it is essential to interrogate how whiteness continues to be privileged in the ways feminist anthropology is charted and conveyed to new generations of students. This article centers on the lessons white feminist anthropologists can learn from the Cite Black Women movement for our teaching. I argue that we must commit to building pedagogical communities of antiracist citational politics and praxis—within which we can seek guidance, inspiration, and support for this work, but that also serve as an important site for mutual accountability. Not only does this bolster our individual efforts, but it forces us to move beyond wielding inclusive citation practices as a personal accomplishment deserving of special acknowledgment or accolades.},
  langid = {english},
  keywords = {antiracist teaching,citational politics,Cite Black Women,white feminist anthropologists},
