@article{pedrianaLegalDoctrineSocial2017,
  title = {From {{Legal Doctrine}} to {{Social Transformation}}? {{Comparing U}}.{{S}}. {{Voting Rights}}, {{Equal Employment Opportunity}}, and {{Fair Housing Legislation}}},
  shorttitle = {From {{Legal Doctrine}} to {{Social Transformation}}?},
  author = {Pedriana, Nicholas and Stryker, Robin},
  date = {2017},
  journaltitle = {American Journal of Sociology},
  volume = {123},
  number = {1},
  eprint = {26545989},
  eprinttype = {jstor},
