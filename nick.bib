@article{skarpelisArchivesAlgorithmsDistance2026,
  title = {From {{Archives}} to {{Algorithms}}: {{Distance}}, {{Evidence}}, and {{Inference}}},
  shorttitle = {From {{Archives}} to {{Algorithms}}},
  author = {Skarpelis, A. K. M.},
  date = {2026-04-20},
  journaltitle = {Sociologica},
