  doi = {10.1086/225431},
  url = {https://www.journals.uchicago.edu/doi/abs/10.1086/225431},
  urldate = {2020-05-21},
  abstract = {This study analyzes the contents of a systematic sample of book reviews in the past 20-year period to determine the patterns of the (1) affective nature of critiques, (2) types of criticisms emphasized, and (3) regionality of reviewers.The American Journal of Sociology, American Sociological Review, and Social Forces were selected for this analysis. The years 1949, 1954, 1959, 1964, 1969, and 1971, were selected, and 2,378 book reviews were analyzed. Nearly 70\% of the reviews for these years expressed positive attitudes toward the books, less than 20\% were negative, and the remainder received no criticism. Until 1971, the regionality of book reviewers was clearly biased for the AJS and Social Forces, whereas book review contributions to the ASR are fairly evenly balanced throughout the six regions identified by the American Sociological Association, an exception being the South which is considerably underrepresented. An analysis of the two most recent publication years, 1970 and 1971, revealed that book review contributions from the South have increased substantially over the previous years analyzed, and current book review contributions are more equitably distributed throughout the six regions. Contentions of recent researchers that regional bias exists in the control, editorhip, and selection of items for inclusion in the ASR were tentatively refuted.},
  file = {/run/media/nick/data/Zotero/storage/AQJJIDNF/225431.html}
}

