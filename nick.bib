@article{ahmedWomenLeftMigration2020,
  title = {Women {{Left Behind}}: {{Migration}}, {{Agency}}, and the {{Pakistani Woman}}},
  shorttitle = {Women {{Left Behind}}},
  author = {Ahmed, Sarah},
  date = {2020-08-01},
  journaltitle = {Gender \& Society},
  volume = {34},
  number = {4},
