@article{cisterninoSlopShakespeare,
  title = {Slop or {{Shakespeare}}},
  author = {Cisternino, Irissa and Judson, Hannah},
  abstract = {Generative AI technologies are increasingly used to create images, texts, and other forms of media. Both amateur creatives and industry professionals have begun to experiment with these technologies for creative purposes, and in turn, this adoption has led to turbulence within the media industries and media audiences. As the place of generative AI technologies within contemporary media production continues to increase, one core question that arises concerns the valuation and evaluation of AI-generated media products alongside more traditional media. This paper articulates the ways that AI-generated creative works may interact with existing practices of valuation for creative works and cultural goods. We argue that sociologists interested in valuation should take an interest in generative AI, and discuss areas in which friction has already arisen. We ultimately conclude that tensions around valuation will continue to arise as a result of differences in valuation ideologies, creative norms, and a disconnect between prioritization of the extrinsic, profit-driven modes of valuation vs the intrinsic value of artistic works.},
