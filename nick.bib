  author = {Lincoln, Anne E. and Pincus, Stephanie and Koster, Janet Bandows and Leboy, Phoebe S.},
  date = {2012-04-01},
  journaltitle = {Social Studies of Science},
  shortjournal = {Soc Stud Sci},
  volume = {42},
